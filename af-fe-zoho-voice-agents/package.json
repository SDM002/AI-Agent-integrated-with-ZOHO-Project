    "clean": "node -e \"try{require('fs').rmSync('.next',{recursive:true,force:true,maxRetries:5,retryDelay:200});}catch(e){console.warn('Skipping .next cleanup:',e.code||e.message)}\"",
    "prebuild": "npm run clean",
    "build": "next build",
    "postbuild": "node -e \"if(process.platform==='win32'){try{require('child_process').execFileSync('attrib',['+S','+H','.next','/S','/D'],{stdio:'ignore'})}catch(e){console.warn('Skipping Windows attrib on .next:',e.code||e.message)}}\"",
